@page "/"
@implements IDisposable
@inject WorkdayService Service
@inject WorkEntryHistoryService HistoryService
@inject EntryDraft Draft
@inject TimesheetAssistant.Components.Layout.GlobalStatus GlobalStatus
@inject IJSRuntime JS

<PageTitle>Timesheet</PageTitle>
<div inert="@(_delete is not null)">
<TimesheetAssistant.Components.PageHeader Title="Timesheet" />

<div class="toolbar">
    <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="OpenAdd">Add entry</button>
    <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="RefreshAsync">Refresh</button>
</div>
<section aria-label="Entries" aria-busy="@(_busy ? "true" : "false")"
         data-local-today="@(HistoryService.Snapshot is { } snapshot ? DateText(snapshot.LocalToday) : null)"
         data-oldest-boundary="@(HistoryService.Snapshot?.OldestLoadedBoundary is { } boundary ? DateText(boundary) : null)">
    @if (_busy) { <p role="status">Loading entries…</p> }
    @if (_historyError is not null)
    {
        <div class="alert alert-warning" role="alert">@_historyError</div>
        <button type="button" class="btn btn-outline-primary" disabled="@_busy" @onclick="RetryAsync">Retry history</button>
    }
    @if (HistoryService.Snapshot is { } history)
    {
        var days = history.Days.Prepend(history.Today).Where(day => day.Entries.Count > 0).OrderByDescending(day => day.Date).ToArray();
        @if (days.Length == 0) { <p>No entries yet. Add your first entry.</p> }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle entries-table">
                    <thead><tr><th scope="col" class="entry-date">Date</th><th scope="col" class="entry-jira">Jira ID</th><th scope="col">Item title</th><th scope="col">Work description</th><th scope="col" class="entry-duration">Duration</th><th scope="col" class="entry-actions">Actions</th></tr></thead>
                    @foreach (var day in days)
                    {
                        var statusClass = day.Totals.RemainingMinutes == 0 && day.Totals.ExcessMinutes == 0 ? "success" : "warning";
                        var statusIcon = statusClass == "success" ? "✓" : "⚠";
                        <tbody data-work-date="@DateText(day.Date)">
                            <tr class="day-summary">
                                <th scope="rowgroup" colspan="6">
                                    <div class="day-summary-content">
                                        <span class="status-icon status-@statusClass" aria-hidden="true">@statusIcon</span>
                                        <time datetime="@DateText(day.Date)">@DisplayDate(day.Date)</time>
                                        <span class="day-total">Total: @DurationParser.Format(day.Totals.TotalMinutes)</span>
                                        <span class="day-balance">· @(day.Totals.ExcessMinutes > 0 ? $"Excess: {DurationParser.Format(day.Totals.ExcessMinutes)}" : $"Remaining: {DurationParser.Format(day.Totals.RemainingMinutes)}")</span>
                                    </div>
                                </th>
                            </tr>
                            @foreach (var entry in day.Entries.OrderBy(entry => entry.CreationOrder))
                            {
                                <tr @key="entry.Id" data-entry-id="@entry.Id">
                                    <td class="entry-date" title="@DateText(day.Date)">@DateText(day.Date)</td><td class="entry-jira" title="@entry.JiraId">@entry.JiraId</td><td>@entry.Title</td><td class="description">@entry.Description</td><td class="entry-duration">@DurationParser.Format(entry.DurationMinutes)</td>
                                    <td class="entry-actions"><button type="button" class="btn btn-sm btn-outline-primary" disabled="@_busy" @onclick="() => OpenEdit(entry)">Edit</button> <button type="button" class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="() => RequestDelete(entry)">Delete</button></td>
                                </tr>
                            }
                        </tbody>
                    }
                </table>
            </div>
        }
        @if (history.HasOlder) { <button type="button" class="btn btn-outline-primary" disabled="@_busy" @onclick="LoadOlderAsync">Load older day</button> }
        else { <p>All earlier days loaded.</p> }
    }
</section>
</div>

@if (_dialogOpen)
{
    <dialog @ref="_dialog" aria-labelledby="dialog-title" class="entry-dialog">
        <h2 id="dialog-title">@(_editing is null ? "Add entry" : "Edit entry")</h2>
        @if (_error is not null) { <div role="alert" class="alert alert-danger">@_error</div> }
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault novalidate>
            <fieldset disabled="@_busy">
                <div class="mb-3"><label for="work-date" class="form-label">Work date</label><input id="work-date" type="date" class="form-control" value="@_form.Date" @onchange="SetDate" max="@DateText(Today)" disabled="@(_editing is not null)" aria-describedby="date-error" /><div id="date-error" class="text-danger" role="alert">@FieldError("WorkDate")</div></div>
                <div class="mb-3"><label for="jira-id" class="form-label">Jira ID</label><input id="jira-id" class="form-control" @bind="_form.JiraId" @bind:event="oninput" aria-required="true" aria-invalid="@(FieldError("JiraId") is not null ? "true" : "false")" aria-describedby="jira-error" /><div id="jira-error" class="text-danger" role="alert">@FieldError("JiraId")</div></div>
                <div class="mb-3"><label for="item-title" class="form-label">Item title</label><input id="item-title" class="form-control" @bind="_form.Title" @bind:event="oninput" aria-required="true" aria-invalid="@(FieldError("Title") is not null ? "true" : "false")" aria-describedby="title-error" /><div id="title-error" class="text-danger" role="alert">@FieldError("Title")</div></div>
                <div class="mb-3"><label for="work-description" class="form-label">Work description (optional)</label><textarea id="work-description" class="form-control" rows="2" @bind="_form.Description" @bind:event="oninput"></textarea></div>
                <div class="mb-3"><label for="duration" class="form-label">Duration</label><input id="duration" class="form-control" @bind="_form.Duration" @bind:event="oninput" aria-required="true" aria-invalid="@(FieldError("Duration") is not null ? "true" : "false")" aria-describedby="duration-help duration-error" /><div id="duration-help" class="form-text">For example: 1h, 30m or 6h 12m. Enter 1 minute to 24 hours.</div><div id="duration-error" class="text-danger" role="alert">@FieldError("Duration")</div></div>
                <button type="submit" class="btn btn-primary">Save</button> <button type="button" class="btn btn-outline-secondary" @onclick="DismissAsync">Cancel</button>
            </fieldset>
        </form>
    </dialog>
}
@if (_delete is not null)
{
    <WorkdayConfirmation Title="Delete entry?" Message="@DeleteMessage" ConfirmText="Delete" Confirmed="DeleteAsync" Cancelled="CancelDelete" />
}

@code {
    private bool _busy;
    private bool _retryOlder;
    private string? _historyError;
    private string? _error;
    private IReadOnlyDictionary<string, string>? _errors;
    private EntryDraft _form = new();
    private WorkEntry? _editing;
    private WorkEntry? _delete;
    private bool _dialogOpen;
    private bool _showDialog;
    private ElementReference _dialog;
    private DotNetObjectReference<WorkdayPage>? _reference;
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);
    private string DeleteMessage => $"Delete {_delete?.JiraId} ({DurationParser.Format(_delete?.DurationMinutes ?? 0)})? This cannot be undone.";

    protected override async Task OnInitializedAsync()
    {
        _reference = DotNetObjectReference.Create(this);
        await RefreshAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showDialog)
        {
            _showDialog = false;
            await JS.InvokeVoidAsync("entryDialog.open", _dialog, _reference);
        }
    }

    private void SetDate(ChangeEventArgs args)
    {
        _form.Date = args.Value?.ToString() ?? string.Empty;
    }

    private void OpenAdd()
    {
        _editing = null;
        _form = Draft;
        OpenDialog();
    }

    private void OpenEdit(WorkEntry entry)
    {
        _editing = entry;
        _form = new EntryDraft { Date = DateText(entry.WorkDate), JiraId = entry.JiraId, Title = entry.Title, Description = entry.Description, Duration = DurationParser.Format(entry.DurationMinutes) };
        OpenDialog();
    }

    private void OpenDialog()
    {
        _errors = null;
        _error = null;
        _dialogOpen = true;
        _showDialog = true;
    }

    [JSInvokable]
    public async Task DismissAsync()
    {
        if (_busy || !_dialogOpen)
        {
            return;
        }
        await JS.InvokeVoidAsync("entryDialog.close", _dialog);
        _dialogOpen = false;
        _editing = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveAsync()
    {
        if (_busy)
        {
            return;
        }
        _errors = null;
        _error = null;
        if (!DateOnly.TryParseExact(_form.Date, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var date))
        {
            _errors = new Dictionary<string, string> { ["WorkDate"] = "Enter a valid work date." };
            return;
        }
        _busy = true;
        var input = new WorkEntryInput(_form.JiraId, _form.Title, _form.Description, _form.Duration);
        var result = _editing is null ? await Service.AddAsync(date, input) : await Service.UpdateAsync(_editing.Id, date, input);
        _busy = false;
        if (!result.IsSuccess)
        {
            _errors = result.Errors;
            _error = result.FailureReason == WorkdayFailure.Validation ? "Check the highlighted fields and try again." : "Could not save this entry. Your input has been kept.";
            return;
        }
        var wasAdd = _editing is null;
        if (wasAdd)
        {
            Draft.Date = DateText(date);
            Draft.Clear();
        }
        await DismissAsync();
        await ReadHistoryAsync(false);
        await RevealSavedDateAsync(date);
        GlobalStatus.Show(wasAdd ? "Entry saved." : "Entry updated.");
    }

    private void RequestDelete(WorkEntry entry)
    {
        _delete = entry;
    }
    private void CancelDelete()
    {
        _delete = null;
    }
    private async Task DeleteAsync()
    {
        var entry = _delete;
        _delete = null;
        if (entry is null || _busy)
        {
            return;
        }
        _busy = true;
        var result = await Service.DeleteAsync(entry.Id, entry.WorkDate);
        _busy = false;
        if (result.IsSuccess)
        {
            await ReadHistoryAsync(false);
            GlobalStatus.Show("Entry deleted.");
        }
        else
        {
            _historyError = "Could not delete this entry. Check local storage access and try again.";
        }
    }

    private Task RefreshAsync() => ReadHistoryAsync(false);
    private Task LoadOlderAsync() => ReadHistoryAsync(true);
    private Task RetryAsync() => ReadHistoryAsync(_retryOlder);

    private async Task RevealSavedDateAsync(DateOnly date)
    {
        while (_historyError is null && HistoryService.Snapshot is { HasOlder: true } snapshot
            && snapshot.OldestLoadedBoundary is { } boundary && date < boundary)
        {
            await ReadHistoryAsync(true);
        }
    }

    private async Task ReadHistoryAsync(bool older)
    {
        if (_busy)
        {
            return;
        }
        _busy = true;
        _retryOlder = older;
        try
        {
            var result = older ? await HistoryService.LoadOlderAsync() : await HistoryService.RefreshAsync();
            _historyError = result.IsSuccess ? null : HistoryService.Snapshot is null ? "Could not load entries. Check local storage access and retry." : "History could not be refreshed. Previously loaded entries have been kept. Retry when storage is available.";
        }
        finally
        {
            _busy = false;
        }
    }

    private string? FieldError(string field) => _errors is not null && _errors.TryGetValue(field, out var error) ? error : null;
    private static string DateText(DateOnly date) => date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    private static string DisplayDate(DateOnly date) => date.ToString("D", System.Globalization.CultureInfo.GetCultureInfo("en-US"));
    public void Dispose()
    {
        _reference?.Dispose();
    }
}
