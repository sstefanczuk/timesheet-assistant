@page "/"
@implements IDisposable
@inject WorkdayService Service
@inject WorkEntryHistoryService HistoryService
@inject EntryDraft Draft
@inject TimesheetAssistant.Components.Layout.GlobalStatus GlobalStatus
@inject IJSRuntime JS

<PageTitle>Timesheet</PageTitle>
<div inert="@(_delete is not null)">
<TimesheetAssistant.Components.PageHeader Title="Timesheet" />

<div class="toolbar">
    <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="OpenAdd"><svg class="button-icon" aria-hidden="true" viewBox="0 0 16 16"><path d="M8 2v12M2 8h12" /></svg>Add entry</button>
    <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="RefreshAsync"><svg class="button-icon" aria-hidden="true" viewBox="0 0 16 16"><path d="M13 5V2l-2 2a5 5 0 1 0 2 5" /></svg>Refresh</button>
</div>
<section aria-label="Entries" aria-busy="@(_busy ? "true" : "false")"
         data-local-today="@(HistoryService.Snapshot is { } snapshot ? DateText(snapshot.LocalToday) : null)"
         data-oldest-boundary="@(HistoryService.Snapshot?.OldestLoadedBoundary is { } boundary ? DateText(boundary) : null)">
    @if (_busy) { <p role="status">Loading entries…</p> }
    @if (_historyError is not null)
    {
        <div class="alert alert-warning" role="alert">@_historyError</div>
        <button type="button" class="btn btn-outline-primary" disabled="@_busy" @onclick="RetryAsync">Retry history</button>
    }
    @if (HistoryService.Snapshot is { } history)
    {
        var days = history.Days.Prepend(history.Today).Where(day => day.Entries.Count > 0).OrderByDescending(day => day.Date).ToArray();
        @if (days.Length == 0) { <p>No entries yet. Add your first entry.</p> }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle entries-table">
                    <thead><tr><th scope="col" class="entry-date">Date</th><th scope="col" class="entry-jira">Jira ID</th><th scope="col">Item title</th><th scope="col">Work description</th><th scope="col" class="entry-duration">Duration</th><th scope="col" class="entry-actions">Actions</th></tr></thead>
                    @foreach (var day in days)
                    {
                        var statusClass = day.Totals.RemainingMinutes == 0 && day.Totals.ExcessMinutes == 0 ? "success" : "warning";
                        var statusIcon = statusClass == "success" ? "✓" : "⚠";
                        <tbody data-work-date="@DateText(day.Date)">
                            <tr class="day-summary">
                                <th scope="rowgroup" colspan="6">
                                    <div class="day-summary-content">
                                        <span class="status-icon status-@statusClass" aria-hidden="true">@statusIcon</span>
                                        <time datetime="@DateText(day.Date)">@DisplayDate(day.Date)</time>
                                        <span class="day-total">· Total: @DurationParser.Format(day.Totals.TotalMinutes)</span>
                                        <span class="day-balance">· @(day.Totals.ExcessMinutes > 0 ? $"Excess: {DurationParser.Format(day.Totals.ExcessMinutes)}" : $"Remaining: {DurationParser.Format(day.Totals.RemainingMinutes)}")</span>
                                        <span class="summary-separator" aria-hidden="true">·</span>
                                        <span class="summary-button-wrap" tabindex="0" title="@(day.Totals.TotalMinutes != WorkdayTotals.TargetMinutes ? $"Summaries are locked: total is {DurationParser.Format(day.Totals.TotalMinutes)}; it must be exactly 7h 12m." : null)">
                                            <button type="button" class="btn btn-sm btn-outline-primary summary-button @(day.Totals.TotalMinutes == WorkdayTotals.TargetMinutes ? "" : "summary-button-disabled")" aria-label="Summaries for @DisplayDate(day.Date)" aria-disabled="@(_busy || day.Totals.TotalMinutes != WorkdayTotals.TargetMinutes)"
                                                    @onclick="() => OpenSummaryAsync(day.Date)"><svg class="button-icon" aria-hidden="true" viewBox="0 0 16 16"><path d="M2 3.5h12v9H2zM5 6h6M5 8h4M5 10h2" /></svg></button>
                                        </span>
                                    </div>
                                </th>
                            </tr>
                            @foreach (var entry in day.Entries.OrderBy(entry => entry.CreationOrder))
                            {
                                <tr @key="entry.Id" data-entry-id="@entry.Id">
                                    <td class="entry-date" title="@DateText(day.Date)">@DateText(day.Date)</td><td class="entry-jira" title="@entry.JiraId">@entry.JiraId</td><td>@entry.Title</td><td class="description">@entry.Description</td><td class="entry-duration">@DurationParser.Format(entry.DurationMinutes)</td>
                                    <td class="entry-actions"><button type="button" class="btn btn-sm btn-outline-primary icon-action" aria-label="Edit entry" title="Edit entry" disabled="@_busy" @onclick="() => OpenEdit(entry)"><svg class="button-icon" aria-hidden="true" viewBox="0 0 16 16"><path d="m11.5 2.5 2 2-8 8-3 1 1-3zM10 4l2 2" /></svg></button> <button type="button" class="btn btn-sm btn-outline-primary duplicate-button" aria-label="Duplicate entry" title="Duplicate entry" disabled="@_busy" @onclick="() => OpenDuplicateAsync(entry)"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5 1.5h7.75A1.75 1.75 0 0 1 14.5 3.25V11a1.75 1.75 0 0 1-1.75 1.75H12v-1.5h.75a.25.25 0 0 0 .25-.25V3.25A.25.25 0 0 0 12.75 3H5v.75H3.5v-.5A1.75 1.75 0 0 1 5 1.5Z"/><path d="M3.25 5A1.75 1.75 0 0 0 1.5 6.75v6A1.75 1.75 0 0 0 3.25 14.5h6A1.75 1.75 0 0 0 11 12.75v-6A1.75 1.75 0 0 0 9.25 5h-6Zm-.25 1.75a.25.25 0 0 1 .25-.25h6a.25.25 0 0 1 .25.25v6a.25.25 0 0 1-.25.25h-6a.25.25 0 0 1-.25-.25v-6Z"/></svg></button> <button type="button" class="btn btn-sm btn-outline-danger icon-action" aria-label="Delete entry" title="Delete entry" disabled="@_busy" @onclick="() => RequestDelete(entry)"><svg class="button-icon" aria-hidden="true" viewBox="0 0 16 16"><path d="M3 4h10M6 4V2.5h4V4m2 0-.6 9H4.6L4 4m2 2v5m4-5v5" /></svg></button></td>
                                </tr>
                            }
                        </tbody>
                    }
                </table>
            </div>
        }
        @if (history.HasOlder) { <button type="button" class="btn btn-outline-primary" disabled="@_busy" @onclick="LoadOlderAsync">Load more...</button> }
        else { <p>All earlier days loaded.</p> }
    }
</section>
</div>

@if (_dialogOpen)
{
    <dialog @ref="_dialog" aria-labelledby="dialog-title" class="entry-dialog">
        <h2 id="dialog-title">@(_editing is null ? "Add entry" : "Edit entry")</h2>
        @if (_error is not null) { <div role="alert" class="alert alert-danger">@_error</div> }
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault novalidate>
            <fieldset disabled="@_busy">
                <div class="mb-3"><label for="work-date" class="form-label">Work date</label><input id="work-date" type="date" class="form-control" value="@_form.Date" @onchange="SetDate" max="@DateText(Today)" disabled="@(_editing is not null)" aria-describedby="date-error" /><div id="date-error" class="text-danger" role="alert">@FieldError("WorkDate")</div></div>
                <div class="mb-3"><label for="jira-id" class="form-label">Jira ID</label><input id="jira-id" class="form-control" @bind="_form.JiraId" @bind:event="oninput" aria-required="true" aria-invalid="@(FieldError("JiraId") is not null ? "true" : "false")" aria-describedby="jira-error" /><div id="jira-error" class="text-danger" role="alert">@FieldError("JiraId")</div></div>
                <div class="mb-3"><label for="item-title" class="form-label">Item title</label><input id="item-title" class="form-control" @bind="_form.Title" @bind:event="oninput" aria-required="true" aria-invalid="@(FieldError("Title") is not null ? "true" : "false")" aria-describedby="title-error" /><div id="title-error" class="text-danger" role="alert">@FieldError("Title")</div></div>
                <div class="mb-3"><label for="work-description" class="form-label">Work description (optional)</label><textarea id="work-description" class="form-control" rows="2" @bind="_form.Description" @bind:event="oninput"></textarea></div>
                <div class="mb-3"><label for="duration" class="form-label">Duration</label><input id="duration" class="form-control" @bind="_form.Duration" @bind:event="oninput" aria-required="true" aria-invalid="@(FieldError("Duration") is not null ? "true" : "false")" aria-describedby="duration-help duration-error" /><div id="duration-help" class="form-text">For example: 1h, 30m or 6h 12m. Enter 1 minute to 24 hours.</div><div id="duration-error" class="text-danger" role="alert">@FieldError("Duration")</div></div>
                <button type="submit" class="btn btn-primary">Save</button> <button type="button" class="btn btn-outline-secondary" @onclick="DismissAsync">Cancel</button>
            </fieldset>
        </form>
    </dialog>
}
@if (_delete is not null)
{
    <WorkdayConfirmation Title="Delete entry?" Message="@DeleteMessage" ConfirmText="Delete" Confirmed="DeleteAsync" Cancelled="CancelDelete" />
}
@if (_summaryDialogOpen && _summary is not null)
{
    <dialog @ref="_summaryDialog" aria-labelledby="summary-title" class="summary-dialog">
        <h2 id="summary-title">Workday summaries — @DisplayDate(_summary.WorkDate)</h2>
        @if (_summaryError is not null)
        {
            <div class="alert alert-danger" role="alert">@_summaryError</div>
        }
        <div class="summary-tabs" role="tablist" aria-label="Summary system">
            <button @ref="_jiraTab" type="button" role="tab" id="jira-tab" class="@(_activeSummaryTab == SummaryTab.Jira ? "active" : null)" autofocus aria-selected="@(_activeSummaryTab == SummaryTab.Jira ? "true" : "false")"
                    aria-controls="jira-panel" tabindex="@(_activeSummaryTab == SummaryTab.Jira ? 0 : -1)"
                    @onclick="() => SelectSummaryTab(SummaryTab.Jira)" @onkeydown="HandleSummaryTabKeyAsync">Jira</button>
            <button @ref="_myWorkTab" type="button" role="tab" id="mywork-tab" class="@(_activeSummaryTab == SummaryTab.MyWork ? "active" : null)" aria-selected="@(_activeSummaryTab == SummaryTab.MyWork ? "true" : "false")"
                    aria-controls="mywork-panel" tabindex="@(_activeSummaryTab == SummaryTab.MyWork ? 0 : -1)"
                    @onclick="() => SelectSummaryTab(SummaryTab.MyWork)" @onkeydown="HandleSummaryTabKeyAsync">MyWork</button>
        </div>
        @if (_activeSummaryTab == SummaryTab.Jira)
        {
            <section id="jira-panel" role="tabpanel" aria-labelledby="jira-tab" tabindex="0">
                <div class="table-responsive">
                    <table class="table align-middle summary-table">
                        <thead><tr><th scope="col">Jira ID</th><th scope="col">Item title</th><th scope="col">Work description</th><th scope="col">Time</th><th scope="col">Copy</th></tr></thead>
                        <tbody>
                            @foreach (var (row, index) in _summary.JiraRows.Select((row, index) => (row, index)))
                            {
                                <tr>
                                    <td>@row.JiraId</td><td>@row.Title</td><td class="description">@row.Description</td><td>@DurationParser.Format(row.DurationMinutes)</td>
                                    <td class="summary-copy-actions">
                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => CopyJiraIdAsync(row.JiraId, index)">Copy ID</button>
                                        @if (!string.IsNullOrWhiteSpace(row.Description))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => CopyWorkDescriptionAsync(row.Description, index)">Copy description</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot><tr class="summary-total"><th scope="row" colspan="3">Total</th><td>@DurationParser.Format(_summary.JiraTotalMinutes)</td><td></td></tr></tfoot>
                    </table>
                </div>
            </section>
        }
        else
        {
            <section id="mywork-panel" role="tabpanel" aria-labelledby="mywork-tab" tabindex="0">
                <div class="table-responsive">
                    <table class="table align-middle summary-table">
                        <thead><tr><th scope="col">Work description</th><th scope="col">Time</th><th scope="col">Copy</th></tr></thead>
                        <tbody>
                            @foreach (var (row, index) in _summary.MyWorkRows.Select((row, index) => (row, index)))
                            {
                                <tr>
                                    <td class="description">@row.WorkDescription</td><td>@DurationParser.Format(row.DurationMinutes)</td>
                                    <td><button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => CopyMyWorkDescriptionAsync(row.WorkDescription, index)">Copy description</button></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot><tr class="summary-total"><th scope="row">Total</th><td>@DurationParser.Format(_summary.MyWorkTotalMinutes)</td><td></td></tr></tfoot>
                    </table>
                </div>
            </section>
        }
        <p class="summary-copy-status" role="status" aria-live="polite">@_copyStatus</p>
        <button type="button" class="btn btn-outline-secondary" @onclick="DismissSummaryAsync">Close</button>
    </dialog>
}

@code {
    private bool _busy;
    private bool _retryOlder;
    private string? _historyError;
    private string? _error;
    private IReadOnlyDictionary<string, string>? _errors;
    private EntryDraft _form = new();
    private WorkEntry? _editing;
    private bool _duplicating;
    private WorkEntry? _delete;
    private bool _dialogOpen;
    private bool _showDialog;
    private ElementReference _dialog;
    private bool _summaryDialogOpen;
    private bool _showSummaryDialog;
    private ElementReference _summaryDialog;
    private ElementReference _jiraTab;
    private ElementReference _myWorkTab;
    private WorkdaySummary? _summary;
    private string? _summaryError;
    private string? _copyStatus;
    private SummaryTab _activeSummaryTab = SummaryTab.Jira;
    private DotNetObjectReference<WorkdayPage>? _reference;
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);
    private string DeleteMessage => $"Delete {_delete?.JiraId} ({DurationParser.Format(_delete?.DurationMinutes ?? 0)})? This cannot be undone.";

    protected override async Task OnInitializedAsync()
    {
        _reference = DotNetObjectReference.Create(this);
        await RefreshAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showDialog)
        {
            _showDialog = false;
            await JS.InvokeVoidAsync("entryDialog.open", _dialog, _reference);
        }

        if (_showSummaryDialog)
        {
            _showSummaryDialog = false;
            await JS.InvokeVoidAsync("entryDialog.open", _summaryDialog, _reference, "DismissSummaryAsync");
        }
    }

    private void SetDate(ChangeEventArgs args)
    {
        _form.Date = args.Value?.ToString() ?? string.Empty;
    }

    private void OpenAdd()
    {
        _editing = null;
        _duplicating = false;
        _form = Draft;
        OpenDialog();
    }

    private void OpenEdit(WorkEntry entry)
    {
        _editing = entry;
        _duplicating = false;
        _form = new EntryDraft { Date = DateText(entry.WorkDate), JiraId = entry.JiraId, Title = entry.Title, Description = entry.Description, Duration = DurationParser.Format(entry.DurationMinutes) };
        OpenDialog();
    }

    private async Task OpenDuplicateAsync(WorkEntry entry)
    {
        if (_busy || _dialogOpen)
        {
            return;
        }

        _busy = true;
        _historyError = null;
        var suggestion = await Service.SuggestNextIncompleteWeekdayAsync(entry.WorkDate);
        _busy = false;

        if (!suggestion.IsSuccess || !suggestion.SuggestedDate.HasValue)
        {
            _historyError = "Could not prepare a duplicate. Check local storage access and try again.";
            return;
        }

        _editing = null;
        _duplicating = true;
        _form = new EntryDraft
        {
            Date = DateText(suggestion.SuggestedDate.Value),
            JiraId = entry.JiraId,
            Title = entry.Title,
            Description = entry.Description,
            Duration = DurationParser.Format(entry.DurationMinutes)
        };
        OpenDialog();
    }

    private void OpenDialog()
    {
        _errors = null;
        _error = null;
        _dialogOpen = true;
        _showDialog = true;
    }

    private async Task OpenSummaryAsync(DateOnly date)
    {
        if (_busy || _summaryDialogOpen || HistoryService.Snapshot is not { } history
            || !history.Days.Prepend(history.Today).Any(day => day.Date == date
                && day.Totals.TotalMinutes == WorkdayTotals.TargetMinutes))
        {
            return;
        }

        _busy = true;
        _historyError = null;
        _summaryError = null;
        _copyStatus = null;

        var result = await Service.LoadAsync(date);
        _busy = false;

        if (!result.IsSuccess || Service.Snapshot is not { } snapshot || snapshot.Date != date)
        {
            _historyError = "Could not refresh this day. The summary was not opened; check local storage access and try again.";
            return;
        }

        if (snapshot.Totals.TotalMinutes != WorkdayTotals.TargetMinutes)
        {
            _historyError = "This day changed and no longer totals exactly 7h 12m. Refresh the entries and try again.";
            return;
        }

        try
        {
            _summary = WorkdaySummary.Create(snapshot.Entries);
        }
        catch (ArgumentException)
        {
            _historyError = "This day could not be summarized. Refresh the entries and try again.";
            return;
        }

        _activeSummaryTab = SummaryTab.Jira;
        _summaryDialogOpen = true;
        _showSummaryDialog = true;
    }

    [JSInvokable]
    public async Task DismissSummaryAsync()
    {
        if (!_summaryDialogOpen)
        {
            return;
        }

        await JS.InvokeVoidAsync("entryDialog.close", _summaryDialog);
        _summaryDialogOpen = false;
        _summary = null;
        await InvokeAsync(StateHasChanged);
    }

    private void SelectSummaryTab(SummaryTab tab)
    {
        _activeSummaryTab = tab;
    }

    private async Task HandleSummaryTabKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key is "ArrowLeft" or "ArrowRight" or "Home" or "End")
        {
            _activeSummaryTab = args.Key switch
            {
                "Home" or "ArrowLeft" => SummaryTab.Jira,
                _ => SummaryTab.MyWork
            };

            await (_activeSummaryTab == SummaryTab.Jira ? _jiraTab : _myWorkTab).FocusAsync();
        }
    }

    private async Task CopyTextAsync(string value, string fieldName)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
            _copyStatus = "Copied";
            GlobalStatus.Show("Copied.");
        }
        catch (JSException)
        {
            _copyStatus = $"Could not copy the {fieldName.ToLowerInvariant()}. Select the text and copy it manually.";
        }
        catch (InvalidOperationException)
        {
            _copyStatus = $"Could not copy the {fieldName.ToLowerInvariant()}. Select the text and copy it manually.";
        }
    }

    private Task CopyJiraIdAsync(string value, int rowIndex) => CopyTextAsync(value, $"Jira ID for row {rowIndex + 1}");

    private Task CopyWorkDescriptionAsync(string value, int rowIndex) => CopyTextAsync(value, $"work description for row {rowIndex + 1}");

    private Task CopyMyWorkDescriptionAsync(string value, int rowIndex) => CopyTextAsync(value, $"MyWork description for row {rowIndex + 1}");

    [JSInvokable]
    public async Task DismissAsync()
    {
        if (_busy || !_dialogOpen)
        {
            return;
        }
        await JS.InvokeVoidAsync("entryDialog.close", _dialog);
        _dialogOpen = false;
        _editing = null;
        _duplicating = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveAsync()
    {
        if (_busy)
        {
            return;
        }
        _errors = null;
        _error = null;
        if (!DateOnly.TryParseExact(_form.Date, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var date))
        {
            _errors = new Dictionary<string, string> { ["WorkDate"] = "Enter a valid work date." };
            return;
        }
        _busy = true;
        var input = new WorkEntryInput(_form.JiraId, _form.Title, _form.Description, _form.Duration);
        var wasDuplicate = _duplicating;
        var result = _editing is null ? await Service.AddAsync(date, input) : await Service.UpdateAsync(_editing.Id, date, input);
        _busy = false;
        if (!result.IsSuccess)
        {
            _errors = result.Errors;
            _error = result.FailureReason == WorkdayFailure.Validation ? "Check the highlighted fields and try again." : "Could not save this entry. Your input has been kept.";
            return;
        }
        var wasAdd = _editing is null;
        if (wasAdd)
        {
            if (!_duplicating)
            {
                Draft.Date = DateText(date);
                Draft.Clear();
            }
        }
        await DismissAsync();
        await ReadHistoryAsync(false);
        await RevealSavedDateAsync(date);
        GlobalStatus.Show(wasAdd ? wasDuplicate ? "Entry duplicated." : "Entry saved." : "Entry updated.");
    }

    private void RequestDelete(WorkEntry entry)
    {
        _delete = entry;
    }
    private void CancelDelete()
    {
        _delete = null;
    }
    private async Task DeleteAsync()
    {
        var entry = _delete;
        _delete = null;
        if (entry is null || _busy)
        {
            return;
        }
        _busy = true;
        var result = await Service.DeleteAsync(entry.Id, entry.WorkDate);
        _busy = false;
        if (result.IsSuccess)
        {
            await ReadHistoryAsync(false);
            GlobalStatus.Show("Entry deleted.");
        }
        else
        {
            _historyError = "Could not delete this entry. Check local storage access and try again.";
        }
    }

    private Task RefreshAsync() => ReadHistoryAsync(false);
    private Task LoadOlderAsync() => ReadHistoryAsync(true);
    private Task RetryAsync() => ReadHistoryAsync(_retryOlder);

    private async Task RevealSavedDateAsync(DateOnly date)
    {
        while (_historyError is null && HistoryService.Snapshot is { HasOlder: true } snapshot
            && snapshot.OldestLoadedBoundary is { } boundary && date < boundary)
        {
            await ReadHistoryAsync(true);
        }
    }

    private async Task ReadHistoryAsync(bool older)
    {
        if (_busy)
        {
            return;
        }
        _busy = true;
        _retryOlder = older;
        try
        {
            var result = older ? await HistoryService.LoadOlderAsync() : await HistoryService.RefreshAsync();
            _historyError = result.IsSuccess ? null : HistoryService.Snapshot is null ? "Could not load entries. Check local storage access and retry." : "History could not be refreshed. Previously loaded entries have been kept. Retry when storage is available.";
        }
        finally
        {
            _busy = false;
        }
    }

    private string? FieldError(string field) => _errors is not null && _errors.TryGetValue(field, out var error) ? error : null;
    private static string DateText(DateOnly date) => date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    private static string DisplayDate(DateOnly date) => date.ToString("D", System.Globalization.CultureInfo.GetCultureInfo("en-US"));

    private enum SummaryTab
    {
        Jira,
        MyWork
    }

    public void Dispose()
    {
        _reference?.Dispose();
    }
}
