@inherits LayoutComponentBase
@implements IDisposable
@inject TimesheetAssistant.Features.Settings.ThemePreference Theme
@inject TimesheetAssistant.Components.Layout.GlobalStatus Status

<div class="page @(Theme.IsLight ? "theme-light" : "theme-dark")">
    <div class="sidebar">
        <NavMenu />
    </div>
    <main>
        <article class="content">
            @Body
        </article>
    </main>
    <div class="global-status" role="status" aria-live="polite" aria-atomic="true">@Status.Message</div>
</div>

@code {
    protected override void OnInitialized()
    {
        Theme.Changed += OnThemeChanged;
        Status.Changed += OnThemeChanged;
    }

    private void OnThemeChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
        Status.Changed -= OnThemeChanged;
    }
}
